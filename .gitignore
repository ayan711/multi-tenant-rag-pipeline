# ── Secrets — NEVER commit these ─────────────────────────────────────────────
.env

# ── ChromaDB bind-mount data ──────────────────────────────────────────────────
# The directory is tracked (via .gitkeep) but the generated data files are not.
chroma_data/*
!chroma_data/.gitkeep

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/
env/
dist/
build/

# ── Temporary upload staging ──────────────────────────────────────────────────
# PDFs are staged here during ingestion (Task 5.3) then deleted by the worker.
/tmp/

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
